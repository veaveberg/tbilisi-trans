<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.veave.transit-data-refresh</string>
<key>ProgramArguments</key><array><string>/usr/local/bin/python3.13</string><string>__STATE__/repo/scripts/daily-data-refresh.py</string></array>
<key>WorkingDirectory</key><string>__STATE__/repo</string>
<key>EnvironmentVariables</key><dict><key>PYTHONUNBUFFERED</key><string>1</string><key>TZ</key><string>Asia/Tbilisi</string></dict>
<key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
<key>StandardOutPath</key><string>__STATE__/logs/refresh.log</string>
<key>StandardErrorPath</key><string>__STATE__/logs/refresh.log</string>
<key>ProcessType</key><string>Background</string>
<key>LowPriorityIO</key><true/>
<key>Umask</key><integer>63</integer>
</dict></plist>
