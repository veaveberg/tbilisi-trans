{
  "name": "tbilisi-transit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prefetch": "npm run prefetch:tbilisi && npm run prefetch:rustavi",
    "prefetch:tbilisi": "node scripts/prefetch-tbilisi.js",
    "prefetch:rustavi": "node scripts/prefetch-rustavi.js",
    "data:update": "node scripts/update-data.js",
    "data:update:no-archive": "node scripts/update-data.js --skip-archive",
    "data:update:tbilisi": "node scripts/update-data.js --source=tbilisi",
    "data:update:tbilisi:no-archive": "node scripts/update-data.js --source=tbilisi --skip-archive",
    "data:update:rustavi": "node scripts/update-data.js --source=rustavi",
    "data:update:rustavi:no-archive": "node scripts/update-data.js --source=rustavi --skip-archive",
    "data:intervals": "node scripts/generate_interval_patterns.cjs",
    "data:manifest": "node scripts/write-data-manifest.js && node scripts/sync-ota-files.js",
    "data:ota": "node scripts/sync-ota-files.js",
    "data:export-route-overrides": "node scripts/export-route-overrides.js",
    "data:archive-and-manifest": "node scripts/update-data.js --skip-fetch",
    "verify:directions-url": "node scripts/verify-directions-url.js",
    "check:live-bus-fit": "node scripts/check-live-bus-polyline-fit.js",
    "build": "vite build",
    "build:all": "npm run data:update && vite build",
    "build:cap": "VITE_BASE_URL=/ npm run build",
    "build:ios": "VITE_BASE_URL=/ VITE_OUT_DIR=dist-ios VITE_DISABLE_PWA=1 npm run build && npx cap copy ios",
    "sync:ios": "npm run build:ios",
    "fix-archive": "node scripts/fix-latest-archive.cjs",
    "build:android": "VITE_BASE_URL=/ VITE_OUT_DIR=dist-ios VITE_DISABLE_PWA=1 npm run build && npx cap copy android",
    "sync:android": "npm run build:android",
    "android:open": "export JAVA_HOME='/Applications/Android Studio.app/Contents/jbr/Contents/Home' && npx cap open android",
    "android:run": "export JAVA_HOME='/Applications/Android Studio.app/Contents/jbr/Contents/Home' && npx cap run android",
    "android:build": "export JAVA_HOME='/Applications/Android Studio.app/Contents/jbr/Contents/Home' && cd android && ./gradlew assembleDebug",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.0.1",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@turf/turf": "^7.3.2",
    "convex": "^1.31.4",
    "date-fns": "^3.3.1",
    "dotenv": "^17.2.3",
    "mapbox-gl": "^3.9.0",
    "svg-path-properties": "^2.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "vite": "^5.1.4",
    "vite-plugin-pwa": "^1.2.0"
  }
}
